{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataprod.platform/contracts/reason-code.schema.json",
  "title": "OEE Reason Code",
  "description": "Hierarchical reason code for OEE 1.1 loss classification. Historical events keep the original reasonCodeId.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["reasonCodeId", "name", "active"],
  "properties": {
    "reasonCodeId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "active": { "type": "boolean" },
    "parentReasonCodeId": { "type": ["string", "null"] },
    "classification": {
      "type": ["string", "null"],
      "enum": [
        "MICROSTOP",
        "UNPLANNED_DOWNTIME",
        "PLANNED_DOWNTIME",
        "CHANGEOVER",
        "IDLE_TIME",
        "EQUIPMENT_FAILURE",
        "MATERIAL_STARVATION",
        "QUALITY_STOP",
        "UNKNOWN_STOP",
        null
      ]
    },
    "equipmentIds": { "type": "array", "items": { "type": "string" } },
    "equipmentTypes": { "type": "array", "items": { "type": "string" } },
    "signals": { "type": "array", "items": { "type": "string" } }
  }
}
