# AAS Data Product Environment Configuration
# Copy to .env and fill in actual values for local development

# Service Configuration
SERVICE_NAME=aas-data-product
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8080
DEBUG=False

# AAS Repository Configuration
AAS_REPOSITORY_URL=http://localhost:4000
AAS_REGISTRY_URL=http://localhost:4001
AAS_PERSISTENCE=sqlite
AAS_SQLITE_PATH=.data/aas.sqlite
# AAS_DB_URL=postgresql://user:password@localhost/aas_db

# Source System Configuration
SOURCE_SYSTEM=${{ values.assetSource }}
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_TOPIC=${{ values.mqttTopic }}
REST_ENDPOINT=${{ values.restEndpoint }}

# CORS Configuration
CORS_ORIGINS=["*"]

# Observability
OBSERVABILITY_ENABLED=True
METRICS_PORT=8081
