{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataprod.platform/contracts/temperature-event.schema.json",
  "title": "Temperature Event",
  "description": "Canonical MQTT temperature event for the MQTT Temperature Data Product.",
  "version": "1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "deviceId", "timestamp", "temperature", "unit"],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique event identifier used for idempotent ingest."
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "description": "Non-empty device identifier."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 datetime of the reading."
    },
    "temperature": {
      "type": "number",
      "description": "Numeric temperature value."
    },
    "unit": {
      "type": "string",
      "enum": ["C", "F"],
      "description": "Temperature unit."
    }
  }
}
