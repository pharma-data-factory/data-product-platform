# Portainer / hosted Control Plane environment template.
# Copy to a Portainer stack env file. Never commit filled values.
# Do not reuse the local Compose Postgres password on a shared host.

# Public HTTPS origin. No trailing slash. Same value for app and backend
# when the reverse proxy terminates TLS in front of port 7007.
APP_BASE_URL=https://data.example.com
BACKEND_BASE_URL=https://data.example.com

# GHCR image tag. Prefer sha-<short-sha> or mvp-1.0. Do not rely on latest.
CONTROL_PLANE_IMAGE=ghcr.io/pharma-data-factory/data-product-platform:mvp-1.0
CONTROL_PLANE_PORT=7007

# Session signing key. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
BACKEND_SECRET=

# GitHub *user* OAuth App (Pharma Data Factory Login). Client ID starts Ov23.
# Callback must be exactly: https://<domain>/api/auth/github/handler/frame
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_CALLBACK_URL=https://data.example.com/api/auth/github/handler/frame

# GitHub *App* for repository publishing. Client ID starts Iv23.
# Do not reuse AUTH_GITHUB_* values. Private key as one line with \n.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=pharma-data-factory

# Postgres. Choose a unique password. Never reuse the local Compose default.
POSTGRES_USER=pdf
POSTGRES_PASSWORD=
POSTGRES_DATABASE=pharma_data_factory

# Keep BLOCKED until legal/counsel explicitly approves customer distribution.
LEGAL_DISTRIBUTION_STATUS=BLOCKED

# Create-authorization audit JSONL on the named volume (not Part 11).
CREATE_AUTHORIZATION_AUDIT_PATH=/app/.runtime/create-authorization-audit.jsonl
