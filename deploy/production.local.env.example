# Local smoke / pilot env for docker-compose.production.yml
# Copy to deploy/production.local.env (gitignored) and adjust.
#
#   copy deploy\production.local.env.example deploy\production.local.env
#   .\scripts\build-production-image.ps1
#   docker compose -f docker-compose.production.yml --env-file deploy/production.local.env up -d
#
# Prefer: .\scripts\prepare-production-local-env.ps1
# That writes a throwaway RSA key so Octokit accepts GITHUB_APP_* at boot.
# Replace AUTH_/GITHUB_APP_* before real login or scaffolding.
# Do not use this file on a shared host without rotating secrets.

APP_BASE_URL=http://localhost:7007
BACKEND_BASE_URL=http://localhost:7007

CONTROL_PLANE_IMAGE=pharma-data-factory:mvp-1.0
CONTROL_PLANE_PORT=7007

# Generate a real secret for any shared pilot:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
BACKEND_SECRET=local-production-smoke-secret-change-me

# OAuth App placeholders (required by compose; login will fail until real)
AUTH_GITHUB_CLIENT_ID=local-smoke-oauth-client
AUTH_GITHUB_CLIENT_SECRET=local-smoke-oauth-secret
AUTH_GITHUB_CALLBACK_URL=http://localhost:7007/api/auth/github/handler/frame

# GitHub App (required by compose). appId must be non-zero; privateKey must
# be valid PEM (one line with \n). prepare-production-local-env.ps1 fills both.
# Publish still fails until a real App is installed.
GITHUB_APP_ID=999001
GITHUB_CLIENT_ID=local-smoke-app-client
GITHUB_CLIENT_SECRET=local-smoke-app-secret
GITHUB_PRIVATE_KEY=REPLACE_WITH_VALID_RSA_PEM_ONE_LINE
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=pharma-data-factory

POSTGRES_USER=pdf
POSTGRES_PASSWORD=local-prod-smoke-pdf-change-me
POSTGRES_DATABASE=pharma_data_factory

LEGAL_DISTRIBUTION_STATUS=BLOCKED
CREATE_AUTHORIZATION_AUDIT_PATH=/app/.runtime/create-authorization-audit.jsonl
