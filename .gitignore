# macOS
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory generated when running tests with coverage
coverage

# Python bytecode / packaging
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Dependencies
node_modules/

# Yarn files
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Node version directives
.nvmrc

# dotenv environment variables file
.env
.env.*
!.env.example

# Build output
dist
dist-types

# Temporary change files created by Vim
*.swp

# MkDocs build output
site

# Local configuration files
*.local.yaml
!app-config.local.yaml

# Sensitive credentials
*-credentials.yaml

# vscode database functionality support files
*.session.sql

# E2E test reports
e2e-test-report/

# Cache
.cache/

# Local template dry-runs
.tmp/

# Generated OEE pilot artifact (recreated by pilot/oee/generate.py)
pilot/oee/generated/

# Runtime certification overlay. Catalog annotations remain canonical.
catalog/certification-overrides.json

# Local Marketplace organization-link table (customer identifiers)
var/
.runtime/
*.marketplace-links.json
.sqlite/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
