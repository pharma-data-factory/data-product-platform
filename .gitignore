# =========================================================
# PERFORMANCE - definitely ignore
# =========================================================

node_modules/
**/node_modules/

coverage/
**/coverage/

.pytest_cache/
**/.pytest_cache/

.runtime/
**/.runtime/

dist/
**/dist/

dist-types/
**/dist-types/

build/
**/build/

.cache/
**/.cache/

tmp/
**/tmp/

temp/
**/temp/

*.log
*.tmp
*.bak
.tmp-*
.tmp_*
tsc-output.txt


# =========================================================
# YARN - ignore generated/cache data
# =========================================================

.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz

# Keep .yarn/releases and config if you use Yarn Berry


# =========================================================
# GENERATED / RUNTIME DATA
# =========================================================

var/
**/var/
catalog/runtime/
packages/backend/validation/runtime/

test-results/
playwright-report/
.nyc_output/

# Local databases / runtime state
.sqlite/
**/.sqlite/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
platform-components/asset-semantic/aas-foundation/.data/


# =========================================================
# PYTHON GENERATED
# =========================================================

__pycache__/
**/__pycache__/

*.pyc
*.pyo
*.egg-info/
**/*.egg-info/

.venv/
venv/


# =========================================================
# IDE / OS
# =========================================================

.idea/
.vscode/

.DS_Store
Thumbs.db


# =========================================================
# SECRETS
# =========================================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local
deploy/production.local.env

# Keep examples because AI should understand configuration
!.env.example

# Local AI configuration may contain provider credentials
app-config.ai.yaml


# =========================================================
# LARGE GENERATED ARTIFACTS
# =========================================================

*.zip
*.tar
*.tgz
*.gz

