# Copy to `.env` and fill in local values.
#   copy .env.example .env
# Never commit `.env`.

# GitHub user login (OAuth App) — portal authentication only.
# Separate from the GitHub App used to publish repositories.
# Create an OAuth App named "Nexora Login" with:
#   Homepage URL: http://localhost:3000
#   Authorization callback URL: http://localhost:7007/api/auth/github/handler/frame
# Do not reuse GITHUB_APP_ID / GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET / GITHUB_PRIVATE_KEY.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_CALLBACK_URL=http://localhost:7007/api/auth/github/handler/frame

# GitHub App — required to publish generated repositories (yarn start:github).
# Create the App, transfer it to pharma-data-factory if needed, then
# install it on that organization (All repositories).
# Creating the App without installing it causes: No token available for host: github.com
# Do not reuse these values for AUTH_GITHUB_* user login.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# PEM private key as a single line with escaped newlines.
# Example:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_PRIVATE_KEY=

# Optional fallback for a personal-account demo only.
# Not required when the GitHub App is installed.
# Scopes if used: repo, workflow
GITHUB_TOKEN=

# Hosted Control Plane (Portainer). Leave empty for local yarn start.
# Local Docker Compose still uses localhost URLs in app-config.docker.yaml.
# Production/pilot must set HTTPS values. See deploy/portainer.env.example.
APP_BASE_URL=
BACKEND_BASE_URL=
BACKEND_SECRET=
GITHUB_ORG=pharma-data-factory

# PostgreSQL — used by local Docker Compose only. Password `dpp` is local-only.
# Hosted Postgres must set a unique POSTGRES_PASSWORD in Portainer.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dpp
POSTGRES_PASSWORD=dpp
POSTGRES_DATABASE=pharma_data_factory

# Hosted/compose Create-authorization audit JSONL. Leave empty for local
# yarn start (default .runtime/ next to the process). Compose sets
# /app/.runtime/create-authorization-audit.jsonl on the named volume.
CREATE_AUTHORIZATION_AUDIT_PATH=

# Optional remote Nexora industrial providers. Empty = mock fixtures.
# Server-side only. Never put broker passwords or OPC UA secrets here.
NEXORA_CONNECTIVITY_URL=
NEXORA_DATA_QUALITY_URL=
NEXORA_CONTRACTS_URL=

# AWS Marketplace integration (optional). Leave empty for local/dev.
# Prefer IAM roles / workload identity in deployed environments.
# Do not commit AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, session tokens,
# registration tokens, or Marketplace customer identifiers.
AWS_MARKETPLACE_REGION=
AWS_MARKETPLACE_PRODUCT_CODE=
# Test Marketplace overlay only. Never production customers.
# AWS_MARKETPLACE_CUSTOMER_ACCOUNT=
# AWS_MARKETPLACE_LICENSE_ARN=
# LEGAL_DISTRIBUTION_STATUS=BLOCKED
# AWS_MARKETPLACE_LINK_STORE=
